{
  "name": "abandoned-not-forgotten",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "bun check && node ./node_modules/vite/bin/vite.js build",
    "preview": "bun run build && node ./node_modules/wrangler/bin/wrangler.js dev",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "bun lint",
    "format": "bun fmt",
    "check": "bun check",
    "assets:fetch": "bun scripts/fetch-moon-kit.mjs",
    "assets:textures": "bun scripts/build-textures.mjs",
    "assets:site-media": "bun scripts/fetch-site-media.mjs",
    "assets:models": "bun scripts/optimize-models.mjs",
    "assets:narration": "bun scripts/generate-narration.mjs",
    "content:check": "bun test src/data",
    "deploy": "bun run build && node ./node_modules/wrangler/bin/wrangler.js deploy"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "camera-controls": "^3.1.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@gltf-transform/cli": "^4.5.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "latest",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  }
}
